<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>SERVERHUB — Minecraft Server Platform</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

html{scroll-behavior:smooth}

body{
font-family:Arial,sans-serif;
background:#070b09;
color:#fff;
overflow-x:hidden;
}

body:before{
content:"";
position:fixed;
width:500px;
height:500px;
top:-250px;
left:-180px;
background:#20e879;
opacity:.09;
filter:blur(120px);
border-radius:50%;
pointer-events:none;
}

body:after{
content:"";
position:fixed;
width:450px;
height:450px;
right:-220px;
bottom:-220px;
background:#20e879;
opacity:.06;
filter:blur(120px);
border-radius:50%;
pointer-events:none;
}

a{
text-decoration:none;
color:inherit;
}

button{
font-family:inherit;
cursor:pointer;
}

header{
height:68px;
position:sticky;
top:0;
z-index:50;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 6%;
background:rgba(7,11,9,.88);
backdrop-filter:blur(15px);
border-bottom:1px solid #19251f;
}

.logo{
font-size:21px;
font-weight:900;
letter-spacing:1px;
}

.logo span{
color:#35e77d;
}

nav{
display:flex;
gap:25px;
color:#9ba59f;
font-size:14px;
}

nav a:hover{
color:#35e77d;
}

.login{
padding:10px 18px;
border-radius:10px;
border:1px solid #294334;
background:#101612;
color:#fff;
font-weight:bold;
}

.hero{
min-height:680px;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:90px 20px;
}

.hero-content{
max-width:850px;
}

.badge{
display:inline-block;
padding:8px 14px;
border-radius:30px;
border:1px solid #275e3d;
background:#0d1c13;
color:#51ed8c;
font-size:13px;
margin-bottom:25px;
}

.hero h1{
font-size:clamp(44px,9vw,82px);
line-height:.95;
letter-spacing:-4px;
font-weight:900;
margin-bottom:28px;
}

.green{
color:#35e77d;
}

.hero p{
max-width:680px;
margin:auto;
font-size:17px;
line-height:1.7;
color:#9ca69f;
}

.buttons{
display:flex;
justify-content:center;
gap:12px;
margin-top:34px;
flex-wrap:wrap;
}

.btn{
padding:15px 25px;
border-radius:12px;
font-weight:900;
font-size:14px;
border:0;
}

.primary{
background:#31df76;
color:#061009;
box-shadow:0 0 30px rgba(49,223,118,.13);
}

.primary:hover{
background:#48eb88;
transform:translateY(-2px);
}

.secondary{
background:#101612;
color:#fff;
border:1px solid #293a30;
}

.secondary:hover{
border-color:#35e77d;
}

.online{
margin-top:35px;
display:flex;
justify-content:center;
align-items:center;
gap:9px;
font-size:13px;
color:#77827b;
}

.dot{
width:8px;
height:8px;
border-radius:50%;
background:#35e77d;
box-shadow:0 0 12px #35e77d;
}

.section{
max-width:1150px;
margin:auto;
padding:90px 6%;
}

.title{
text-align:center;
margin-bottom:45px;
}

.title h2{
font-size:35px;
margin-bottom:12px;
}

.title p{
color:#818c85;
line-height:1.6;
}

.cards{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
}

.card{
padding:28px;
border-radius:18px;
border:1px solid #1b2a21;
background:linear-gradient(145deg,#101612,#0b100d);
transition:.25s;
}

.card:hover{
transform:translateY(-5px);
border-color:#2e6545;
}

.icon{
width:50px;
height:50px;
display:flex;
align-items:center;
justify-content:center;
border-radius:14px;
background:#11281a;
font-size:23px;
margin-bottom:20px;
}

.card h3{
font-size:19px;
margin-bottom:10px;
}

.card p{
font-size:14px;
line-height:1.65;
color:#849089;
}

.flow{
display:flex;
justify-content:center;
align-items:center;
gap:12px;
margin-top:40px;
flex-wrap:wrap;
}

.flow-box{
width:220px;
padding:25px 15px;
text-align:center;
border:1px solid #213128;
border-radius:16px;
background:#0c120e;
}

.flow-box strong{
display:block;
margin-bottom:8px;
}

.flow-box span{
font-size:13px;
color:#758078;
}

.arrow{
font-size:24px;
color:#35e77d;
}

.pricing{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
}

.price-card{
position:relative;
padding:30px;
border-radius:20px;
background:#0d130f;
border:1px solid #1d2c23;
}

.price-card.featured{
border-color:#31d970;
box-shadow:0 0 35px rgba(49,217,112,.08);
}

.popular{
position:absolute;
top:18px;
right:18px;
font-size:10px;
font-weight:bold;
padding:6px 9px;
border-radius:20px;
background:#19482b;
color:#55ed8b;
}

.price-card h3{
font-size:20px;
margin-bottom:18px;
}

.price{
font-size:34px;
font-weight:900;
margin-bottom:23px;
}

.price small{
font-size:12px;
color:#6f7973;
font-weight:normal;
}

.features{
list-style:none;
margin-bottom:28px;
}

.features li{
padding:8px 0;
font-size:14px;
color:#aab3ad;
}

.features li:before{
content:"✓";
color:#39e77d;
font-weight:bold;
margin-right:9px;
}

.price-btn{
width:100%;
padding:13px;
border-radius:10px;
border:1px solid #29382f;
background:#111713;
color:#fff;
font-weight:bold;
}

.featured .price-btn{
background:#31df76;
border:0;
color:#061009;
}

.cta{
max-width:1050px;
margin:40px auto 90px;
padding:65px 25px;
border-radius:25px;
border:1px solid #244432;
text-align:center;
background:radial-gradient(circle,#12351f,#0b110d 60%);
}

.cta h2{
font-size:34px;
margin-bottom:14px;
}

.cta p{
color:#8d9891;
margin-bottom:28px;
}

footer{
padding:35px 6%;
border-top:1px solid #19241e;
display:flex;
justify-content:space-between;
gap:20px;
color:#68736c;
font-size:13px;
}

footer strong{
color:#dce5df;
}

@media(max-width:800px){

header{
padding:0 17px;
}

nav{
display:none;
}

.hero{
min-height:620px;
padding:75px 18px;
}

.hero h1{
font-size:49px;
letter-spacing:-2.5px;
}

.hero p{
font-size:15px;
}

.section{
padding:70px 18px;
}

.cards,
.pricing{
grid-template-columns:1fr;
}

.title h2{
font-size:29px;
}

.flow{
flex-direction:column;
}

.flow-box{
width:100%;
}

.arrow{
transform:rotate(90deg);
}

.cta{
margin:30px 18px 70px;
}

.cta h2{
font-size:28px;
}

footer{
padding:30px 18px;
flex-direction:column;
}
}
</style>
</head>

<body>

